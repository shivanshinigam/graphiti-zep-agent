# Copy to .env and fill in your values
# No API keys required — everything runs locally via Docker!

# Ollama (LLM + embeddings — runs via Docker)
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=phi3:mini
EMBED_MODEL=nomic-embed-text

# Neo4j (graph database — runs via Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti123

# Zep Cloud API Key (optional — Task 3 comparison section only)
# Free at https://www.getzep.com
ZEP_API_KEY=your-zep-api-key-here
